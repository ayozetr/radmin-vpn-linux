#!/bin/bash
# AppRun — Radmin VPN (netns edition, nested)
#
# Runs the ORIGINAL, unmodified Radmin VPN AppImage inside an isolated network
# namespace, which works around the "never ready / waiting for adapter" hang that
# happens when the host has several network interfaces (docker/vmnet/tailscale/…).
# Running the original AppImage as-is (instead of its extracted contents) keeps its
# rendering identical to launching it directly.
#
# Double-click (polkit prompt) or run with `sudo`. Close the Radmin window to exit;
# the namespace + NAT rules are torn down automatically.
set -u

SELF="$(readlink -f "$0")"
APPDIR="$(dirname "$SELF")"
RUSER="${SUDO_USER:-$(id -un)}"
HOMEDIR="$(getent passwd "$RUSER" | cut -d: -f6)"
CACHE="$HOMEDIR/.cache/radmin-vpn-netns"

# Copy the launcher + the inner AppImage to a real dir. The netns setup runs as root
# while Wine runs as the user; both read from $CACHE, and the inner AppImage self-mounts
# as the user (no cross-user FUSE issues). The big inner AppImage is re-copied only when
# missing or changed (its size differs), so a rebuilt/upgraded wrapper propagates; the
# tiny launcher scripts are always refreshed.
extract_if_needed() {
    mkdir -p "$CACHE"
    if [ ! -f "$CACHE/RadminVPN.AppImage" ] || \
       [ "$(stat -c%s "$CACHE/RadminVPN.AppImage" 2>/dev/null)" \
         != "$(stat -c%s "$APPDIR/RadminVPN.AppImage" 2>/dev/null)" ]; then
        echo "[*] unpacking Radmin AppImage to $CACHE (one-time)…"
        cp "$APPDIR/RadminVPN.AppImage" "$CACHE/RadminVPN.AppImage"
        chmod +x "$CACHE/RadminVPN.AppImage"
        chown "$RUSER":"$RUSER" "$CACHE/RadminVPN.AppImage" 2>/dev/null || true
    fi
    cp "$APPDIR/netns-orch.sh"     "$CACHE/netns-orch.sh"
    cp "$APPDIR/radmin-askpass.sh" "$CACHE/radmin-askpass.sh"
    chmod +x "$CACHE/netns-orch.sh" "$CACHE/radmin-askpass.sh"
    chown "$RUSER":"$RUSER" "$CACHE/netns-orch.sh" "$CACHE/radmin-askpass.sh" 2>/dev/null || true
}

RUID="$(id -u "$RUSER")"
ENVPASS=(RADMIN_ORCH=1 RUSER="$RUSER" CACHE="$CACHE"
         DISPLAY="${DISPLAY:-:0}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
         XAUTHORITY="${XAUTHORITY:-$HOMEDIR/.Xauthority}"
         XDG_RUNTIME_DIR="/run/user/$RUID"
         DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$RUID/bus}")

if [ "$(id -u)" -eq 0 ]; then
    # already root (e.g. `sudo ./RadminVPN-netns.AppImage`)
    extract_if_needed
    exec env "${ENVPASS[@]}" bash "$CACHE/netns-orch.sh"
else
    # user context (double-click): unpack, then escalate via polkit
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -a "Radmin VPN" "Radmin VPN" "Setting up… enter your password when prompted." 2>/dev/null &
    extract_if_needed
    if command -v pkexec >/dev/null 2>&1; then
        # Detach the escalation into its own session so the polkit dialog and the whole
        # run survive independently of how the file manager tracks this process (double-
        # click was killing the dialog before you could type the password).
        ( setsid pkexec env "${ENVPASS[@]}" bash "$CACHE/netns-orch.sh" \
              </dev/null >>"$CACHE/launch.log" 2>&1 & )
        exit 0
    else
        echo "pkexec not found — run this AppImage with sudo:" >&2
        echo "  sudo \"$SELF\"" >&2
        exit 1
    fi
fi
